{
  "name": "antenna-draw-desktop",
  "productName": "AntennaDraw Dev",
  "version": "1.0.0-alpha.1",
  "description": "天线覆盖绘图平台 Windows 桌面版",
  "author": "AntennaDraw contributors",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop:dev": "node scripts/desktop-build.cjs dev",
    "test:desktop": "node --test desktop/tests/*.test.cjs && playwright test",

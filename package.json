    "verify:package": "node scripts/package-verify.cjs",
    "test:baseline": "node scripts/baseline.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
